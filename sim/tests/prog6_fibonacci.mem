// Archivo: prog6_fibonacci.mem
// Algoritmo de Fibonacci usando ISA mixto (RV32I y RV32C)
//
// 0x00 a 0x10: Instrucciones de 32 bits (1 instrucción por línea)
06400413  // @0x00: addi x8, x0, 100
00500493  // @0x04: addi x9, x0, 5
00000513  // @0x08: addi x10, x0, 0
00100593  // @0x0C: addi x11, x0, 1
00a42023  // @0x10: sw x10, 0(x8)

// 0x14 a 0x24: Instrucciones de 16 bits empaquetadas (2 por línea)
C931C04C  // @0x14: [15:0] c.sw x11, 4(x8)   | [31:16] loop: c.beqz x9, end
404C4008  // @0x18: [15:0] c.lw x10, 0(x8)   | [31:16] c.lw x11, 4(x8)
C408952E  // @0x1C: [15:0] c.add x10, x11    | [31:16] c.sw x10, 8(x8)
15FD0411  // @0x20: [15:0] c.addi x8, 4      | [31:16] c.addi x9, -1
0001BFF5  // @0x24: [15:0] c.j loop          | [31:16] c.nop (padding)

// 0x28: Fin
0000006f  // @0x28: end: jal x0, 0