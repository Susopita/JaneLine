// Program 5: Test de instrucciones comprimidas (Extension C)
// Resultado esperado: mem[100] = 25 (0x00000019)
//
// Empaquetado: 2 instrucciones de 16 bits por palabra de 32 bits.
//   bits[15:0]  -> instruccion en la direccion par (PC actual)
//   bits[31:16] -> instruccion en la direccion +2

14416405  // c.lui x8, 1      -> x8 = 4096  |  c.addi x8, -16  -> x8 = 4080
80210412  // c.slli x8, 4     -> x8 = 65280  |  c.srli x8, 8   -> x8 = 255
00a00493  // addi x9, x0, 10  -> x9 = 10  (32 bits)
8c258485  // c.srai x9, 1     -> x9 = 5    |  c.xor x8, x9    -> x8 = 250
8c458c65  // c.and x8, x9     -> x8 = 0    |  c.or  x8, x9   -> x8 = 5
04518c05  // c.sub x8, x9     -> x8 = 0    |  c.addi x8, 20  -> x8 = 20
00019426  // c.add x8, x9     -> x8 = 25   |  c.nop
06802223  // sw x8, 100(x0)   -> mem[100] = 25  (32 bits)
0000006f  // jal x0, 0        -> bucle infinito  (32 bits)
