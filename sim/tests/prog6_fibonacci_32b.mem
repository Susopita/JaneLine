// Archivo: prog6_fibonacci_32b.mem
// Algoritmo de Fibonacci usando SOLO ISA Base (RV32I)

// --- Inicialización ---
06400413  // @0x00: addi x8, x0, 100
00500493  // @0x04: addi x9, x0, 5
00000513  // @0x08: addi x10, x0, 0
00100593  // @0x0C: addi x11, x0, 1
00a42023  // @0x10: sw x10, 0(x8)

// --- Bucle Pesa (AHORA EN 32 BITS) ---
00b42223  // @0x14: sw x11, 4(x8)
02048063  // @0x18: loop: beq x9, x0, end  (salta 32 bytes adelante)
00042503  // @0x1C: lw x10, 0(x8)
00442583  // @0x20: lw x11, 4(x8)
00b50533  // @0x24: add x10, x10, x11
00a42423  // @0x28: sw x10, 8(x8)
00440413  // @0x2C: addi x8, x8, 4
fff48493  // @0x30: addi x9, x9, -1
fe1ff06f  // @0x34: jal x0, loop (salta 32 bytes atrás)

// --- Fin ---
0000006f  // @0x38: end: jal x0, 0